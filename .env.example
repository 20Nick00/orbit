# Database location inside the application working directory.
ORBIT_DATABASE_URL=sqlite:///data/orbit.sqlite
# Nightly verified SQLite backups beside the database, in backups/.
ORBIT_BACKUP_KEEP_DAYS=30
# Keep Orbit on localhost until authentication is available.
ORBIT_BIND=127.0.0.1
# Accepted HTTP host names. Add your Tailscale name here if accessing Orbit through it.
ORBIT_ALLOWED_HOSTS=127.0.0.1,localhost
# The address your browser uses, if an HTTPS proxy such as `tailscale serve` is in front of
# Orbit, e.g. https://machine-name.tailnet-name.ts.net. Plaid returns you here after linking.
ORBIT_PUBLIC_URL=
# Host port used by Docker Compose.
ORBIT_PORT=8000
# Optional property estimates. Leave blank to use manual values only.
RENTCAST_API_KEY=
# Request ceiling over the past 31 days, including failed calls (0 disables; max 50).
# This ceiling is per database. Do not share a RentCast key between installs.
ORBIT_RENTCAST_MONTHLY_LIMIT=45
# Optional IANA timezone, e.g. America/New_York. Blank uses this computer's timezone.
# Set ORBIT_TIMEZONE when running in Docker: its clock is UTC, which could close
# months the evening before in your local timezone.
ORBIT_TIMEZONE=
# Backups, nightly sync, monthly closing and property refresh, with startup catch-up.
ORBIT_SCHEDULER_ENABLED=true

# Paystubs. Mailbox fetching is optional and read-only; set a sender or a label, or both.
PAYSTUB_BACKGROUND=1
# Optional override; default is ORBIT_DATA_DIR/paystubs/rules (data/paystubs/rules).
PAYSTUB_RULES_DIR=
PAYSTUB_IMAP_HOST=
PAYSTUB_IMAP_PORT=993
PAYSTUB_IMAP_USER=
# Use an app password for Gmail, never your main password.
PAYSTUB_IMAP_PASSWORD=
PAYSTUB_IMAP_SENDER=
PAYSTUB_IMAP_LABEL=
PAYSTUB_IMAP_LOOKBACK_DAYS=45
PAYSTUB_IMAP_DAY_OF_MONTH=1
# self or family: which IRS HSA limit applies to you.
PAYSTUB_HSA_COVERAGE=self
# Set to 1 if the inbox is on a Docker bind mount.
PAYSTUB_WATCH_POLLING=0

# Plaid credentials from your Plaid dashboard (never commit real values).
PLAID_CLIENT_ID=
PLAID_SECRET=
# Blank uses sandbox. Only sandbox and production are accepted.
PLAID_ENV=
# Webhooks are optional; nightly sync works without them.
# Use a public HTTPS address with exactly the path /plaid/webhook, pointing only
# at ORBIT_WEBHOOK_PORT (a separate listener in the same Orbit process).
# Never point a tunnel at the main port or add a public host to ORBIT_ALLOWED_HOSTS:
# the main app has no login.
# Only connections made or re-authenticated after setting this URL send webhooks.
PLAID_WEBHOOK_URL=
# Leave blank to disable the webhook listener; use a different port from ORBIT_PORT.
# Docker Compose publishes only the main port, so under Docker you must also publish this one.
ORBIT_WEBHOOK_PORT=
ORBIT_WEBHOOK_BIND=127.0.0.1
# Generate once: .venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up this key securely: losing it means reconnecting every institution.
FERNET_KEY=
